@@ -1554,6 +1556,48 @@ static bool encrypt_and_record_outbound_fragments(shunk_t message,
 	 */
 	enum next_payload_types_ikev2 skf_np = fixup_value(sk->logger, &sk->sk_next_payload_field);
 
+	/*
+	 * Test-only reproducer for incomplete-fragment resource retention.
+	 * Build 31 independently protected, near-maximum-size fragments while
+	 * advertising a total of 32.  Entry 32 remains empty and is deliberately
+	 * skipped by send_recorded_v2_message().  Since reassembly never occurs,
+	 * the filler does not need to contain a parseable inner IKE_AUTH message.
+	 */
+	if (impair.v2_incomplete_fragments.enabled) {
+		size_t filler_len = impair.v2_incomplete_fragments.value;
+		if (filler_len == 0 || filler_len > 65000) {
+			llog(RC_LOG, logger,
+			     "v2_incomplete_fragments must be between 1 and 65000 bytes");
+			return false;
+		}
+
+		chunk_t filler = alloc_chunk(filler_len, "incomplete SKF test filler");
+		memset(filler.ptr, 0x33, filler.len);
+		llog(IMPAIR_STREAM, logger,
+		     "building 31 of 32 protected IKEv2 fragments with %zu cleartext bytes each",
+		     filler_len);
+
+		for (unsigned int number = 1; number < MAX_IKE_FRAGMENTS; number++) {
+			if (!encrypt_and_record_outbound_fragment(sk->logger, sk->ike,
+							  &hdr,
+							  unencrypted_payloads_type,
+							  unencrypted_payloads,
+							  previous_to_sk_next_payload_offset,
+							  skf_np,
+							  (*fragments),
+							  HUNK_AS_SHUNK(&filler),
+							  number)) {
+				free_chunk_content(&filler);
+				return false;
+			}
+			skf_np = ISAKMP_NEXT_v2NONE;
+			unencrypted_payloads = null_shunk;
+		}
+
+		free_chunk_content(&filler);
+		return true;
+	}
+
 	unsigned int number = 1;
 	shunk_t clear_cursor = HUNK_AS_SHUNK(&sk->cleartext);
 
